<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ED-Overdrive-FSR</AssemblyName>
    <RootNamespace>GenFrame.Setup</RootNamespace>
    <Version>0.1.0</Version>
    <Product>ED-Overdrive</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- GITC Uplift (MIT, github.com/ghostinthecamera/GITC-Uplift): shipped inside the exe, checked by hash at install. -->
    <EmbeddedResource Include="ThirdParty\GITC-Uplift-1.8.0.zip" LogicalName="GITC-Uplift.zip" />
    <!-- EDAA release (MIT; with Streamline, DLSS, XeSS and their licenses) and the ReShade add-on installer (BSD-3-Clause):
         fetched by ThirdParty\fetch-bundle.ps1 before the build, pinned by hash, not in git. -->
    <EmbeddedResource Include="ThirdParty\EDAA.zip" LogicalName="EDAA.zip" />
    <EmbeddedResource Include="ThirdParty\ReShade_Setup_Addon.exe" LogicalName="ReShade_Setup.exe" />
  </ItemGroup>

  <Target Name="FetchBundle" BeforeTargets="BeforeBuild">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\ThirdParty\fetch-bundle.ps1&quot;" />
  </Target>

</Project>
