<Window x:Class="GenFrame.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ED-Overdrive – FSR experimentell" Width="900" Height="600" MinWidth="760" MinHeight="480"
        Background="{StaticResource WindowBrush}" WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.ColumnSpan="2" Margin="4,0,4,12" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="ED-Overdrive" FontSize="16" FontWeight="SemiBold"/>
            <Border DockPanel.Dock="Right" x:Name="GameStateBadge" CornerRadius="6" Padding="10,3">
                <TextBlock x:Name="GameStateText" FontSize="12"/>
            </Border>
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0,0,12,0" x:Name="Navigation">
            <RadioButton Style="{StaticResource NavButton}" Content="Übersicht" Tag="overview" IsChecked="True" Checked="OnNavigate"/>
            <RadioButton Style="{StaticResource NavButton}" Content="Schnellwahl" Tag="modes" Checked="OnNavigate"/>
            <RadioButton Style="{StaticResource NavButton}" Content="Filter" Tag="filters" Checked="OnNavigate"/>
            <RadioButton Style="{StaticResource NavButton}" Content="Grafik" Tag="graphics" Checked="OnNavigate"/>
            <RadioButton Style="{StaticResource NavButton}" Content="DLSS 5" Tag="dlss5" Checked="OnNavigate"/>
            <RadioButton Style="{StaticResource NavButton}" Content="Elite-Check" Tag="check" Checked="OnNavigate"/>
            <RadioButton Style="{StaticResource NavButton}" Content="Presets" Tag="presets" Checked="OnNavigate"/>
            <RadioButton Style="{StaticResource NavButton}" Content="Einstellungen" Tag="settings" Checked="OnNavigate"/>
            <RadioButton Style="{StaticResource NavButton}" Content="Diagnose" Tag="diagnose" Checked="OnNavigate"/>
            <RadioButton Style="{StaticResource NavButton}" Content="Backups" Tag="backups" Checked="OnNavigate"/>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="18,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="PageHost"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
